{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sauron.example/schemas/policy.schema.json",
  "title": "SauronID Agent-Binding Policy",
  "description": "Declarative DSL describing the limits and obligations of an agent. Covers Sprint 1-3 binding fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "agent"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1",
      "description": "DSL version. Currently always \"1\"."
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "description": "Agent identifier or human label this policy binds."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description."
    },
    "binding": {
      "$ref": "#/$defs/Binding"
    },
    "invariants": {
      "type": "array",
      "items": { "type": "string" },
      "description": "First-class invariant predicate strings (parsed by the Sprint 2 compiler)."
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    }
  },
  "$defs": {
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Optional explicit tool allowlist. Absent => any tool allowed by upstream policies."
        },
        "max_budget_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum spend in USD over the policy lifetime."
        },
        "data_scope": {
          "$ref": "#/$defs/DataScope"
        },
        "rate_limit": {
          "$ref": "#/$defs/RateLimit"
        },
        "time_window": {
          "$ref": "#/$defs/TimeWindow"
        },
        "required_signatures": {
          "type": "array",
          "items": { "$ref": "#/$defs/SignatureRequirement" }
        },
        "delegation": {
          "$ref": "#/$defs/DelegationLimits"
        },
        "domain_allowlist": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Outbound-domain allowlist (DomainAllowlistCheck)."
        },
        "domain_denylist": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Outbound-domain denylist (DomainDenylistCheck)."
        },
        "tool_denylist": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Tool denylist (ToolDenylistCheck)."
        },
        "daily_budget_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Daily spend cap in USD (DailyBudgetCheck)."
        },
        "max_single_action_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Per-action spend cap in USD (PerActionCapCheck)."
        },
        "weekly_rate": {
          "$ref": "#/$defs/WeeklyRate"
        },
        "max_concurrent": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum simultaneous in-flight actions (ConcurrencyCheck)."
        },
        "cooldown_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum gap in seconds between actions (CooldownCheck)."
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum action payload size in bytes (PayloadSizeCheck)."
        },
        "content_type_allowlist": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Allowed MIME types (ContentTypeCheck)."
        },
        "max_recipients": {
          "type": "integer",
          "minimum": 0,
          "description": "Per-action recipient cap (RecipientCountCheck)."
        },
        "max_chain_depth": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum agent-call chain depth (ChainDepthCheck)."
        },
        "pii_block": {
          "type": "boolean",
          "description": "When true, registers PiiDetectionCheck."
        },
        "language_allowlist": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Allowed natural languages (LanguageAllowlistCheck)."
        },
        "currency_allowlist": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "ISO 4217 currency allowlist (CurrencyAllowlistCheck)."
        },
        "geo_allow_countries": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "ISO 3166 allow-country list (GeoRestrictionCheck)."
        },
        "geo_deny_countries": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "ISO 3166 deny-country list (GeoRestrictionCheck)."
        },
        "business_hours": {
          "$ref": "#/$defs/BusinessHours"
        },
        "holiday_blackout_dates": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "description": "Blackout dates YYYY-MM-DD (HolidayBlackoutCheck)."
        },
        "pinned_version": {
          "type": "string",
          "minLength": 1,
          "description": "Exact agent-version pin (VersionPinCheck)."
        },
        "dry_run": {
          "type": "boolean",
          "description": "When true, registers DryRunCheck."
        }
      }
    },
    "DataScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deny": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "RateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests_per_minute"],
      "properties": {
        "requests_per_minute": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "TimeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Window start, HH:MM 24-hour."
        },
        "end": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Window end, HH:MM 24-hour."
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "description": "IANA timezone identifier (e.g. Europe/Paris)."
        }
      }
    },
    "SignatureRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "threshold"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "threshold": { "type": "integer", "minimum": 1 }
      }
    },
    "DelegationLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_depth"],
      "properties": {
        "max_depth": { "type": "integer", "minimum": 0 },
        "allowed_subagents": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "WeeklyRate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests_per_week"],
      "properties": {
        "requests_per_week": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum requests per rolling 7-day window."
        }
      }
    },
    "BusinessHours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekday_windows", "timezone"],
      "properties": {
        "weekday_windows": {
          "type": "object",
          "description": "Map of weekday (0=Sunday..6=Saturday) to a [start, end] HH:MM pair. Absent days block the agent.",
          "additionalProperties": false,
          "patternProperties": {
            "^[0-6]$": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          }
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "description": "IANA timezone identifier (e.g. Europe/Paris)."
        }
      }
    },
    "Metadata": {
      "type": "object",
      "description": "Free-form metadata; additional keys allowed.",
      "properties": {
        "created_at": { "type": "string" },
        "author":     { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
