# ──────────────────────────────────────────────────────────────────────────
# PRIVATE demo identity — copy to `demo.local.env` and fill in. NEVER commit.
#   cp demo.local.env.example demo.local.env   &&   edit demo.local.env
# (deploy/demo.local.env is gitignored; this .example template is committed.)
#
# This is the ONLY place the GPU box + cloud VM identity lives. The driver
# script scripts/demo/democtl.sh reads it to talk to both machines over SSH.
# ──────────────────────────────────────────────────────────────────────────

# ── GPU box (runs the local Ollama agent) ──────────────────────────────────
GPU_HOST=zetroc.fr
GPU_PORT=16641
GPU_USER=projectx
# Working dir the driver rsyncs the agent code into (on the GPU box).
GPU_DIR=~/sauronid-demo
# Model that drives the agent. VERIFIED on the GPU box:
#   gemma4:e4b   — RECOMMENDED. Native tool_calls + reliably returns a final
#                  answer (non-thinking). 2/2 clean runs.
#   qwen3:14b    — native tool_calls but a "thinking" model; sometimes doesn't
#                  converge to a final answer within the turn limit (Act 2 may
#                  print "did not return a final answer"). Works, less reliable.
#   qwen2.5-coder:7b — DO NOT USE (prints the call as text, no native tool_calls).
OLLAMA_MODEL=gemma4:e4b

# ── Cloud VM (runs the SauronID core + dashboard) ───────────────────────────
VM_HOST=REPLACE_WITH_VM_PUBLIC_IP
VM_PORT=22
VM_USER=ubuntu
VM_DIR=~/sauronid-demo

# Public core URL the agent calls (sslip.io = no domain purchase; dots->dashes).
CORE_URL=https://core.REPLACE-VM-IP-WITH-DASHES.sslip.io

# Must MATCH SAURON_ADMIN_KEY in the VM's deploy/.env (server side).
SAURON_ADMIN_KEY=REPLACE_WITH_SAME_ADMIN_KEY_AS_VM

# ── Optional hybrid cloud agents (free tiers recommended) ───────────────────
# Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
# Tavily web-search (free tier: https://tavily.com) — makes the Console agent's
# search/price tasks much better; without it, search falls back to DuckDuckGo.
TAVILY_API_KEY=
# Pay-per-token API keys (NOT a ChatGPT/Claude subscription):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
