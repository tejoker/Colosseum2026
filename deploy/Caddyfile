# SauronID demo reverse proxy.
#
# Caddy terminates TLS (auto Let's Encrypt) and fronts two upstreams:
#   - core.<domain>  -> the SauronID core API (every endpoint self-authenticates;
#                       safe to expose publicly — the remote agent needs it).
#   - dash.<domain>  -> the Next.js dashboard, with an optional outer HTTP
#                       basic-auth defense-in-depth layer in addition to the
#                       dashboard's signed operator sessions.
#
# Requirements: both hostnames must resolve (A record) to this VM, and ports
# 80 + 443 must be open. Substituted from the environment (docker-compose
# passes them through); generate DASH_BASICAUTH_HASH with (optional):
#     docker run --rm caddy caddy hash-password --plaintext '<your-password>'

{
	email {$ACME_EMAIL}
}

{$CORE_DOMAIN} {
	reverse_proxy backend:3001
}

{$DASH_DOMAIN} {
	basic_auth {
		{$DASH_USER} {$DASH_BASICAUTH_HASH}
	}
	reverse_proxy dashboard:3000
}
