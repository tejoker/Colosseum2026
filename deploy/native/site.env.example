# Site config for the no-Docker deploy — read by vm-setup.sh to generate the
# Caddyfile and decide whether to run the dashboard. Copy to site.env ON THE VM.
# Never commit.

# Hostnames (sslip.io needs no purchase; replace dots in the VM IP with dashes).
CORE_DOMAIN=core.REPLACE-VM-IP.sslip.io
DASH_DOMAIN=dash.REPLACE-VM-IP.sslip.io
ACME_EMAIL=you@example.com

# Dashboard basic-auth gate (the dashboard has no built-in user auth).
# Hash: caddy hash-password --plaintext '<password>'
DASH_USER=demo
DASH_BASICAUTH_HASH=REPLACE

# 0 = core API only (leanest; the demo prints the full story to the terminal).
# 1 = also build/run the Next.js dashboard (installs Node 20 on the VM).
ENABLE_DASHBOARD=0
