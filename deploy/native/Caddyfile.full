# Core + dashboard reverse proxy. Caddy substitutes {$VARS} from its process
# environment (systemd drop-in EnvironmentFile=/opt/sauronid/site.env). The
# dashboard is gated behind HTTP basic auth (it has no built-in user auth).
{
	email {$ACME_EMAIL}
}

{$CORE_DOMAIN} {
	reverse_proxy 127.0.0.1:3001
}

{$DASH_DOMAIN} {
	basic_auth {
		{$DASH_USER} {$DASH_BASICAUTH_HASH}
	}
	reverse_proxy 127.0.0.1:3000
}
